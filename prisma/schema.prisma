generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Shop {
  id        String   @id @default(cuid())
  name      String
  phone     String
  address   String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users              User[]
  products           Product[]
  customers          Customer[]
  bills              Bill[]
  billItems          BillItem[]
  udhaarTransactions UdhaarTransaction[]

  @@map("shops")
}

model User {
  id              String   @id @default(cuid())
  shopId          String   @map("shop_id")
  name            String?
  phone           String   @unique
  passwordHash    String   @map("password_hash")
  role            String   @default("OWNER")
  preferredLocale String   @default("en") @map("preferred_locale")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId])
  @@map("users")
}

model Product {
  id                String   @id @default(cuid())
  shopId            String   @map("shop_id")
  name              String
  price             Float
  stockQty          Float    @default(0) @map("stock_qty")
  unit              String   @default("pcs")
  lowStockThreshold Float    @default(5) @map("low_stock_threshold")
  isActive          Boolean  @default(true) @map("is_active")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  shop      Shop       @relation(fields: [shopId], references: [id], onDelete: Cascade)
  billItems BillItem[]

  @@index([shopId, isActive])
  @@index([shopId, name])
  @@map("products")
}

model Customer {
  id        String   @id @default(cuid())
  shopId    String   @map("shop_id")
  name      String
  phone     String?
  balance   Float    @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  shop               Shop                @relation(fields: [shopId], references: [id], onDelete: Cascade)
  bills              Bill[]
  udhaarTransactions UdhaarTransaction[]

  @@unique([shopId, phone])
  @@index([shopId, name])
  @@index([shopId, balance])
  @@map("customers")
}

model Bill {
  id          String   @id @default(cuid())
  shopId      String   @map("shop_id")
  billNumber  Int      @map("bill_number")
  customerId  String?  @map("customer_id")
  totalAmount Float    @map("total_amount")
  paymentMode String   @map("payment_mode") // CASH | UPI | UDHAAR
  shareToken  String   @unique @map("share_token")
  note        String?
  createdAt   DateTime @default(now()) @map("created_at")

  shop               Shop                @relation(fields: [shopId], references: [id], onDelete: Cascade)
  customer           Customer?           @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items              BillItem[]
  udhaarTransactions UdhaarTransaction[]

  @@unique([shopId, billNumber])
  @@index([shopId, createdAt])
  @@index([shopId, customerId])
  @@map("bills")
}

model BillItem {
  id          String   @id @default(cuid())
  shopId      String   @map("shop_id")
  billId      String   @map("bill_id")
  productId   String?  @map("product_id")
  productName String   @map("product_name")
  unit        String
  unitPrice   Float    @map("unit_price")
  quantity    Float
  lineTotal   Float    @map("line_total")
  createdAt   DateTime @default(now()) @map("created_at")

  shop    Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  bill    Bill     @relation(fields: [billId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([shopId, billId])
  @@index([shopId, productId])
  @@map("bill_items")
}

model UdhaarTransaction {
  id          String   @id @default(cuid())
  shopId      String   @map("shop_id")
  customerId  String   @map("customer_id")
  billId      String?  @map("bill_id")
  type        String   // DEBIT | CREDIT
  amount      Float
  paymentMode String?  @map("payment_mode") // CASH | UPI (when CREDIT)
  note        String?
  createdAt   DateTime @default(now()) @map("created_at")

  shop     Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  bill     Bill?    @relation(fields: [billId], references: [id], onDelete: SetNull)

  @@index([shopId, customerId, createdAt])
  @@index([shopId, createdAt])
  @@map("udhaar_transactions")
}

